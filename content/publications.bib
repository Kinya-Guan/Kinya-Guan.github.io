@misc{guan2026particlehole,
  selected = {true},
  title = {Spontaneous particle-hole symmetry breaking in a disordered two-site quantum breakdown model},
  author = {Guan, Kinya},
  year = {2026},
  month = oct,
  eprint = {2610.24669},
  archivePrefix = {arXiv},
  primaryClass = {cond-mat.stat-mech},
  url = {https://arxiv.org/abs/2610.24669},
  doi = {10.48550/arXiv.2610.24669},
  abstract = {We study spontaneous particle-hole symmetry breaking in a disordered two-site quantum breakdown model. The model is solvable in the limit of a large number of fermionic modes on each site. For a small ratio of the numbers of modes on the two sites, we derive the free energy analytically and find a finite-temperature symmetry-breaking transition. This transition changes from continuous to first order as the number of fermions produced in each conversion increases. Numerical results show that both types of transition persist beyond this regime, with an order-parameter exponent close to 1/2 for continuous transitions.},
  note = {arXiv preprint, submitted October 17, 2026},
  description = {arXiv:2610.24669, submitted October 17, 2026. 17 pages, 11 figures, 3 tables.},
  keywords = {quantum breakdown model, particle-hole symmetry, spontaneous symmetry breaking, disordered fermions, finite-temperature phase transition}
}

@misc{kawabata2026chiral,
  selected = {true},
  title = {Chiral quantum chaos around exponentially many zero modes in the quantum breakdown model},
  author = {Kawabata, Kohei and Guan, Kinya and Katsura, Hosho},
  year = {2026},
  month = sep,
  eprint = {2609.39404},
  archivePrefix = {arXiv},
  primaryClass = {cond-mat.str-el},
  url = {https://arxiv.org/abs/2609.39404},
  doi = {10.48550/arXiv.2609.39404},
  abstract = {The quantum breakdown model is a model of randomly interacting fermions, motivated by the physics of dielectric breakdown. Here, we establish classification of symmetry and quantum chaos in a zero-dimensional, all-to-all-interacting version of the quantum breakdown model. It exhibits the ℤ₄ periodicity with respect to the number of fermionic modes, reminiscent of the symmetry classification of the Sachdev-Ye-Kitaev model. A unique feature of the quantum breakdown model is that it realizes all the five classes with chiral symmetry and hosts an exponentially large number of many-body zero modes protected by the chiral index. We elucidate the separation and scaling of the spectral gap and demonstrate the symmetry-enriched hard-edge spectral statistics as signatures of quantum chaos in the chiral symmetry classes.},
  note = {arXiv preprint, submitted September 30, 2026},
  description = {arXiv:2609.39404, submitted September 30, 2026. 16 pages, 5 figures, 7 tables.},
  keywords = {quantum breakdown model, quantum chaos, chiral symmetry, many-body zero modes, spectral statistics}
}

@misc{guan2026qbm,
  selected = {true},
  title = {Exactly Solvable Disorder-free Quantum Breakdown Model: Spectrum, Thermodynamics, and Dynamics},
  author = {Guan, Kinya and Katsura, Hosho},
  year = {2026},
  month = mar,
  eprint = {2603.17379v2},
  archivePrefix = {arXiv},
  primaryClass = {cond-mat.str-el},
  url = {https://arxiv.org/abs/2603.17379v2},
  doi = {10.48550/arXiv.2603.17379},
  abstract = {We introduce and study a disorder-free version of the quantum breakdown model with all-to-all interactions. The Hamiltonian factorizes into the product of the zero-momentum-mode occupation number and a quadratic Hamiltonian including only pairing terms. This structure makes the model exactly solvable and produces an extensive zero-energy degeneracy. We obtain the spectrum and partition function in closed form and analyze the thermodynamics, spectral form factor, two-point functions, and a regulated out-of-time-ordered correlator (OTOC). The OTOC is time independent at leading order in the large-N limit, while its time-dependent contributions first appear at order 1/N. At infinite temperature, the time-dependent correction reduces to a two-point function arising from the zero-momentum component of the fermion operators. The model therefore provides a controlled setting for isolating the consequences of the breakdown interaction in the absence of disorder, spatial structure, and environmental coupling.},
  note = {arXiv preprint, version 2, revised August 28, 2026},
  description = {arXiv:2603.17379v2, revised August 28, 2026. 17 pages, 11 figures. Major revision with corrected numerical results and expanded analytical derivations.},
  keywords = {quantum breakdown model, disorder-free model, exactly solvable model, spectral form factor, OTOC}
}
